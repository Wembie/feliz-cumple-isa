{
  "name": "feliz-cumple-isa",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "description": "A one-of-a-kind interactive birthday experience made with love for Isa.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "estres": "vite build --mode estres && node scripts/estres.mjs",
    "estres:real": "vite build --mode real && node scripts/estres.mjs dist-real",
    "cifrar": "tsx scripts/cifrar.ts",
    "build:prueba": "vite build --mode prueba && tsx scripts/cifrar.ts --prueba",
    "vista-previa": "tsx scripts/vista-previa.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
